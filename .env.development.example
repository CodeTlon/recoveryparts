# Variables para desarrollo local. Se copia a `.env.development` con `npm run setup:dev` (que además genera un
# SESSION_SECRET propio). `.env.development` NO se versiona: cada persona tiene el suyo.
# La base es la del `docker-compose.yml` de desarrollo (npm run db:start, puerto 54322); no es un entorno real.
APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/recoveryparts
# `npm run setup:dev` lo reemplaza por un valor aleatorio (mínimo 32 caracteres).
SESSION_SECRET=se-genera-con-npm-run-setup-dev
STORAGE_DIR=./storage
NEXT_PUBLIC_SITE_URL=http://localhost:3000
