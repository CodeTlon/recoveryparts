# Plantilla para .env.test / .env.production (gitignored). desarrollo usa .env.development (ya versionado).
# APP_ENV: development | test | production. Los scripts de seed se niegan a correr en production.
APP_ENV=test
# Conexión directa a la base: solo para aplicar migraciones (npm run db:push:test|production)
SUPABASE_DB_URL=
# Sitio — usado para construir links de email (invitación, recuperar contraseña)
# dev: http://localhost:3000 · prod: dominio definitivo
NEXT_PUBLIC_SITE_URL=

# Supabase — dos proyectos: recoveryparts-dev (rama dev) / recoveryparts-prod (rama main)
# Ver AGENTS.md -> "Variables de Entorno". Infra 100% manual del usuario.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — formulario de contacto del sitio público
RESEND_API_KEY=
RESEND_FROM_NAME=
RESEND_FROM_EMAIL=
COMPANY_EMAIL=
