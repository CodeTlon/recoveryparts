# Variables del servidor (Coolify las toma del panel; en local usá .env.development / .env.test).
APP_ENV=production
# Postgres con el que corre la app y las migraciones.
DATABASE_URL=postgresql://usuario:clave@db:5432/recoveryparts
# Firma de las cookies de sesión: 32+ caracteres al azar (openssl rand -base64 48).
SESSION_SECRET=
# Carpeta persistente para PDFs y fotos/videos (montar un volumen).
STORAGE_DIR=/data/storage
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Mail (invitaciones, recuperación de contraseña, avisos y bandeja de contacto).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
