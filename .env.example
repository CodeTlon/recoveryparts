# Plantilla. Copiá a .env.staging / .env.production (gitignored) y completá.
# desarrollo usa .env.development (Supabase local, ya versionado).
APP_ENV=staging            # staging | production
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca exponer al cliente ni commitear.
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa a la base (solo para aplicar migraciones desde tu máquina o CI)
SUPABASE_DB_URL=
NEXT_PUBLIC_SITE_URL=https://tu-dominio

# SMTP propio (avisos: "te sumaron al curso", clase suspendida). Pendiente hasta tener dominio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Recovery Parts <no-reply@tudominio.com>"
