{
  "name": "codetlon-demo-template",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:migrate": "ENV_FILE=.env.development node scripts/migrate.mjs",
    "db:reset": "docker compose down -v db && docker compose up -d db --wait && npm run db:migrate",
    "db:migrate:test": "ENV_FILE=.env.test node scripts/migrate.mjs",
    "db:migrate:production": "ENV_FILE=.env.production node scripts/migrate.mjs",
    "seed:dev": "ENV_FILE=.env.development tsx scripts/seed-pruebas.mts --confirmo-no-produccion",
    "seed:test": "ENV_FILE=.env.test tsx scripts/seed-pruebas.mts --confirmo-no-produccion",
    "seed:demo-cliente": "ENV_FILE=.env.production tsx scripts/seed-pruebas.mts --demo-cliente",
    "seed:demo-cliente:purge": "ENV_FILE=.env.production tsx scripts/purgar-demo.mts --purgar-demo",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "0.577.0",
    "motion": "^14.0.0",
    "next": "16.4.2",
    "nodemailer": "^10.0.13",
    "postgres": "3.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
