{
  "name": "codetlon-demo-template",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:migrate": "ENV_FILE=.env.development node scripts/migrate.mjs",
    "db:reset": "docker compose down -v db && docker compose up -d db --wait && npm run db:migrate",
    "db:migrate:test": "ENV_FILE=.env.test node scripts/migrate.mjs",
    "db:migrate:production": "ENV_FILE=.env.production node scripts/migrate.mjs",
    "seed:dev": "ENV_FILE=.env.development tsx scripts/seed-pruebas.mts --confirmo-no-produccion",
    "seed:test": "ENV_FILE=.env.test tsx scripts/seed-pruebas.mts --confirmo-no-produccion"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.400.0",
    "motion": "^14.0.0",
    "next": "15.5.19",
    "nodemailer": "^10.0.13",
    "postgres": "3.4.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "4.19.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
